{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "diceframe-official",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "html_handling": "none"
  },
  "workers_dev": true,
  "routes": [
    {
      "pattern": "diceframe.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
