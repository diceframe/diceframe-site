{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "diceframe-official",
  "main": "src/server.ts",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "diceframe.com",
      "custom_domain": true
    },
    {
      "pattern": "www.diceframe.com/*",
      "zone_name": "diceframe.com"
    }
  ],
  "observability": {
    "enabled": true
  }
}
